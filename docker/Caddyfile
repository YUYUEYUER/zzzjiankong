{
	admin off
}

{$DOMAIN} {
	encode zstd gzip

	handle /browser {
		redir /browser/ 308
	}

	# noVNC's binary socket is authorized and proxied by the application so
	# Origin, short-lived ticket, and session revocation are enforced per connection.
	handle /browser/websockify* {
		reverse_proxy {
			dynamic a frosted-console 8787 {
				refresh 5s
				resolvers 127.0.0.11
				versions ipv4
			}
		}
	}

	# 不再剥前缀：noVNC 静态文件现由应用在 /browser 路径下认证托管
	handle /browser/* {
		forward_auth {
			uri /api/browser-access
			dynamic a frosted-console 8787 {
				refresh 5s
				resolvers 127.0.0.11
				versions ipv4
			}
		}
		reverse_proxy {
			dynamic a frosted-console 8787 {
				refresh 5s
				resolvers 127.0.0.11
				versions ipv4
			}
		}
	}

	handle {
		reverse_proxy {
			dynamic a frosted-console 8787 {
				refresh 5s
				resolvers 127.0.0.11
				versions ipv4
			}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output stdout
		format console
	}
}
