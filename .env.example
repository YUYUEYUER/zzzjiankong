PORT=8787
APP_ORIGIN=http://localhost:8787
DOMAIN=panel.example.com
DATA_FILE=./data/frosted-console.json
MASTER_KEY=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-another-long-random-secret
# 留空时首次打开面板自拟用户名，并由页面生成强密码
ADMIN_USERNAME=
ADMIN_PASSWORD=
AUTH_DISABLED=false
TRUST_PROXY=false
# 面板登录 Cloudflare Turnstile（在 Cloudflare 控制台创建站点后填写）
DASHBOARD_TURNSTILE_SITE_KEY=
DASHBOARD_TURNSTILE_SECRET_KEY=
SEED_DEMO=false
MONITOR_TICK_MS=15000

# Mihomo 仅在 Docker 内部网络提供 Clash 订阅节点与固定代理出口
MIHOMO_SECRET=replace-with-a-long-random-controller-secret
PROXY_BASE_PORT=17890
# 本地运行默认只监听 127.0.0.1；Docker Compose 会显式改为容器内部网络
MIHOMO_BIND_ADDRESS=127.0.0.1
MIHOMO_CONTROLLER_BIND_ADDRESS=127.0.0.1

# 上游登录 Cloudflare Turnstile 自动处理（与面板登录验证相互独立）
# browser (default) | capsolver | 2captcha | none
# browser: Playwright opens the real login page and verifies login in the same browser context
TURNSTILE_SOLVER=browser
# true = headless Chromium; false = visible browser (debug)
TURNSTILE_HEADLESS=false
# 仅限无法启用 Chromium sandbox 的隔离低权限容器；普通服务器保持 false
TURNSTILE_DISABLE_BROWSER_SANDBOX=false
# 同时运行的 Chromium 上限（1-4）
TURNSTILE_BROWSER_CONCURRENCY=2
# 等待浏览器槽位的最大任务数，超过后快速失败
TURNSTILE_BROWSER_QUEUE_LIMIT=20
# Docker 启动时以 pwuser 验证 Chromium 与 sandbox
TURNSTILE_BROWSER_SMOKE_ON_START=true
# 浏览器登录会话主动轮换周期（小时）
UPSTREAM_BROWSER_SESSION_TTL_HOURS=168
# Docker 有头浏览器工作区；服务器域名部署由 docker-compose.server.yml 自动覆盖
NOVNC_ENABLED=true
NOVNC_PORT=6080
NOVNC_GEOMETRY=1600x900x24
BROWSER_WORKSPACE_URL=
# CapSolver: https://www.capsolver.com/
CAPSOLVER_API_KEY=
# 2Captcha: https://2captcha.com/
TWOCAPTCHA_API_KEY=
# Optional shared key override for API solvers
# TURNSTILE_SOLVER_API_KEY=
# TURNSTILE_SOLVE_TIMEOUT_MS=120000
