{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,cyan \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "smoke:browser": "node server/browser-smoke.js",
    "backup": "node server/backup.js create",
    "restore": "node server/backup.js restore",
    "rotate-master-key": "node server/rotate-master-key.js",
    "postinstall": "node -e \"try{require('child_process').execSync('npx playwright install chromium',{stdio:'inherit'})}catch(e){console.warn('[postinstall] playwright chromium skipped:',e.message)}\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "otplib": "^13.4.1",
    "playwright": "^1.61.1",
    "qrcode": "^1.5.4",
    "undici": "7.30.1",
    "ws": "^8.21.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@marsidev/react-turnstile": "^1.5.3",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "motion": "^12.42.2",
    "react": "19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.0",
    "vite": "^6.4.5"
  }
}
